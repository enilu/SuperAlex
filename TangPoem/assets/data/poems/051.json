            "text": "恨别鸟惊心",
            "pinyin": "hèn bié niǎo jīng xīn"
        },
        {
            "text": "烽火连三月",
            "pinyin": "fēng huǒ lián sān yuè"
        },
        {
            "text": "家书抵万金",
            "pinyin": "jiā shū dǐ wàn jīn"
        },
        {
            "text": "白头搔更短",
            "pinyin": "bái tóu sāo gèng duǎn"
        },
        {
            "text": "浑欲不胜簪",
            "pinyin": "hún yù bù shèng zān"
        }
