    "title": "春望",
    "author": "杜甫",
    "dynasty": "唐",
    "grade": "小学五年级",
    "content": [
        {
            "text": "国破山河在",
            "pinyin": "guó pò shān hé zài"
        },
        {
            "text": "城春草木深",
            "pinyin": "chéng chūn cǎo mù shēn"
        },
        {
            "text": "感时花溅泪",
            "pinyin": "gǎn shí huā jiàn lèi"
