    "title": "旅宿",
    "author": "杜牧",
    "dynasty": "唐",
    "grade": "小学课外",
    "content": [
        {
            "text": "旅馆无良伴",
            "pinyin": "lǚ guǎn wú liáng bàn"
        },
        {
            "text": "凝情自悄然",
            "pinyin": "níng qíng zì qiǎo rán"
        },
        {
            "text": "寒灯思旧事",
            "pinyin": "hán dēng sī jiù shì"
        },
        {
            "text": "断雁警愁眠",
            "pinyin": "duàn yàn jǐng chóu mián"
        },
        {
            "text": "远梦归侵晓",
            "pinyin": "yuǎn mèng guī qīn xiǎo"
        },
        {
            "text": "家书到隔年",
            "pinyin": "jiā shū dào gé nián"
        },
        {
            "text": "沧江好烟月",
            "pinyin": "cāng jiāng hào yān yuè"
        },
        {
            "text": "门系钓鱼船",
            "pinyin": "mén jì diào yú chuán"
        }
