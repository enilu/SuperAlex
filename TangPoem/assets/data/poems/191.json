        {
            "text": "一丘常欲卧",
            "pinyin": "yī qiū cháng yù wò"
        },
        {
            "text": "三径苦无资",
            "pinyin": "sān jìng kǔ wú zī"
        },
        {
            "text": "北土非吾愿",
            "pinyin": "běi tǔ fēi wú yuàn"
        },
        {
            "text": "东林怀我师",
            "pinyin": "dōng lín huái wǒ shī"
        },
        {
            "text": "黄金燃桂尽",
            "pinyin": "huáng jīn rán guì jǐn"
        },
        {
            "text": "壮志逐年衰",
            "pinyin": "zhuàng zhì zhú nián shuāi"
        },
        {
            "text": "日夕凉风至",
            "pinyin": "rì xī liáng fēng zhì"
        },
        {
            "text": "闻蝉但益悲",
            "pinyin": "wén chán dàn yì bēi"
        }
