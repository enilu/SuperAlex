    "title": "早秋",
    "author": "许浑",
    "dynasty": "唐",
    "grade": "小学课外",
    "content": [
        {
            "text": "遥夜泛清瑟",
            "pinyin": "yáo yè fàn qīng sè"
        },
        {
            "text": "西风生翠萝",
            "pinyin": "xī fēng shēng cuì luó"
        },
        {
            "text": "残萤栖玉露",
            "pinyin": "cán yíng qī yù lù"
