    "content": [
        {
            "text": "一路经行处",
            "pinyin": "yī lù jīng xíng chǔ"
        },
        {
            "text": "莓苔见屐痕",
            "pinyin": "méi tái jiàn jī hén"
        },
        {
            "text": "白云依静渚",
            "pinyin": "bái yún yī jìng zhǔ"
        },
        {
            "text": "芳草闭闲门",
            "pinyin": "fāng cǎo bì xián mén"
        },
        {
            "text": "过雨看松色",
            "pinyin": "guò yǔ kàn sōng sè"
        },
        {
            "text": "随山到水源",
            "pinyin": "suí shān dào shuǐ yuán"
        },
        {
            "text": "溪花与禅意",
            "pinyin": "xī huā yǔ chán yì"
        },
