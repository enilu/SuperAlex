        {
            "text": "乡心新岁切",
            "pinyin": "xiāng xīn xīn suì qiē"
        },
        {
            "text": "天畔独潸然",
            "pinyin": "tiān pàn dú shān rán"
        },
        {
            "text": "老至居人下",
            "pinyin": "lǎo zhì jū rén xià"
        },
        {
            "text": "春归在客先",
            "pinyin": "chūn guī zài kè xiān"
        },
        {
            "text": "岭猿同旦暮",
            "pinyin": "lǐng yuán tóng dàn mù"
        },
        {
            "text": "江柳共风烟",
            "pinyin": "jiāng liǔ gòng fēng yān"
        },
        {
            "text": "已似长沙傅",
            "pinyin": "yǐ sì cháng shā fù"
        },
        {
            "text": "从今又几年",
            "pinyin": "zòng jīn yòu jī nián"
        }
