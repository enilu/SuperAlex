    "title": "谷口书斋寄杨补阙",
    "author": "钱起",
    "dynasty": "唐",
    "grade": "小学课外",
    "content": [
        {
            "text": "泉壑带茅茨",
            "pinyin": "quán hè dài máo cí"
        },
        {
