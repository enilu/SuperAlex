{
    "id": 269,
    "title": "同从弟南斋玩月忆山阴崔少府",
    "author": "王昌龄",
    "dynasty": "唐",
    "grade": "小学课外",
    "content": [
        {
            "text": "高卧南斋时",
            "pinyin": "gāo wò nán zhāi shí"
        },
        {
            "text": "开帷月初吐",
            "pinyin": "kāi wéi yuè chū tǔ"
        },
        {
            "text": "清辉淡水木",
            "pinyin": "qīng huī dàn shuǐ mù"
        },
        {
            "text": "演漾在窗户",
            "pinyin": "yǎn yàng zài chuāng hù"
        },
        {
            "text": "苒苒几盈虚",
            "pinyin": "rǎn rǎn jī yíng xū"
        },
        {
            "text": "澄澄变今古",
            "pinyin": "chéng chéng biàn jīn gǔ"
        },
        {
            "text": "美人清江畔",
            "pinyin": "měi rén qīng jiāng pàn"
        },
        {
            "text": "是夜越吟苦",
            "pinyin": "shì yè yuè yín kǔ"
        },
        {
            "text": "千里其如何",
            "pinyin": "qiān lǐ qí rú hé"
        },
        {
            "text": "微风吹兰杜",
            "pinyin": "wēi fēng chuī lán dù"
        }
