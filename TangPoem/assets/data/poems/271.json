{
    "id": 271,
    "title": "西施咏",
    "author": "王维",
    "dynasty": "唐",
    "grade": "小学课外",
    "content": [
        {
            "text": "艳色天下重",
            "pinyin": "yàn sè tiān xià zhòng"
        },
        {
            "text": "西施宁久微",
            "pinyin": "xī shī níng jiǔ wēi"
        },
        {
            "text": "朝为越溪女",
            "pinyin": "cháo wéi yuè xī rǔ"
        },
        {
            "text": "暮作吴宫妃",
            "pinyin": "mù zuò wú gōng fēi"
        },
        {
            "text": "贱日岂殊众",
            "pinyin": "jiàn rì qǐ shū zhòng"
        },
        {
            "text": "贵来方悟稀",
            "pinyin": "guì lái fāng wù xī"
        },
        {
            "text": "邀人傅粉粉",
            "pinyin": "yāo rén fù fěn fěn"
        },
        {
            "text": "不自著罗衣",
            "pinyin": "bù zì zhāo luó yī"
        },
        {
            "text": "君宠益娇态",
            "pinyin": "jūn chǒng yì jiāo tài"
        },
        {
            "text": "君怜无是非",
            "pinyin": "jūn lián wú shì fēi"
        },
        {
            "text": "当时浣纱伴",
            "pinyin": "dàng shí huàn shā bàn"
        },
        {
            "text": "莫得同车归",
            "pinyin": "mò dé tóng chē guī"
        },
        {
            "text": "持谢邻家子",
            "pinyin": "chí xiè lín jiā zǐ"
        },
        {
            "text": "效颦安可希",
            "pinyin": "xiào pín ān kě xī"
        }
