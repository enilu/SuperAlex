        {
            "text": "两小无嫌猜",
            "pinyin": "liǎng xiǎo wú xián cāi"
        },
        {
            "text": "十四为君妇",
            "pinyin": "shí sì wéi jūn fù"
        },
        {
            "text": "羞颜未尝开",
            "pinyin": "xiū yán wèi cháng kāi"
