    "content": [
        {
            "text": "梧桐相待老",
            "pinyin": "wú tóng xiāng dài lǎo"
        },
        {
            "text": "鸳鸯会双死",
            "pinyin": "yuān yāng kuài shuāng sǐ"
        },
        {
            "text": "贞妇贵殉夫",
            "pinyin": "zhēn fù guì xùn fū"
        },
        {
            "text": "舍生亦如此",
            "pinyin": "shè shēng yì rú cǐ"
        },
        {
            "text": "波澜誓不起",
            "pinyin": "bō lán shì bù qǐ"
        },
        {
            "text": "妾心古井水",
            "pinyin": "qiè xīn gǔ jǐng shuǐ"
        }
