{
    "id": 370,
    "title": "长歌行",
    "author": "汉乐府",
    "dynasty": "汉",
    "grade": "小学生必背",
    "content": [
        {
            "text": "青青园中葵，",
            "pinyin": "qīng qīng yuán zhōng kuí ，"
        },
        {
            "text": "朝露待日晞。",
            "pinyin": "zhāo lòu dài rì xī 。"
        },
        {
            "text": "阳春布德泽，",
            "pinyin": "yáng chūn bù dé zé ，"
        },
        {
            "text": "万物生光辉。",
            "pinyin": "wàn wù shēng guāng huī 。"
        },
        {
            "text": "常恐秋节至，",
            "pinyin": "cháng kǒng qiū jié zhì ，"
        },
        {
            "text": "焜黄华叶衰。",
            "pinyin": "kūn huáng huá yè shuāi 。"
        },
        {
            "text": "百川东到海，",
            "pinyin": "bǎi chuān dōng dào hǎi ，"
        },
        {
            "text": "何时复西归？",
            "pinyin": "hé shí fù xī guī ？"
        },
        {
            "text": "少壮不努力，",
            "pinyin": "shǎo zhuàng bù nǔ lì ，"
        },
        {
            "text": "老大徒伤悲。",
            "pinyin": "lǎo dà tú shāng bēi 。"
        }
    ],
    "annotation": "",
    "translation": "",
