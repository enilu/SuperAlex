{
    "id": 382,
    "title": "送元二使安西",
    "author": "王维",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "渭城朝雨浥轻尘，",
            "pinyin": "wèi chéng zhāo yǔ yì qīng chén ，"
        },
        {
            "text": "客舍青青柳色新。",
            "pinyin": "kè shě qīng qīng liǔ sè xīn 。"
        },
        {
            "text": "劝君更尽一杯酒，",
            "pinyin": "quàn jūn gēng jìn yī bēi jiǔ ，"
        },
        {
            "text": "西出阳关无故人。",
            "pinyin": "xī chū yáng guān wú gù rén 。"
        }
    ],
    "annotation": "",
