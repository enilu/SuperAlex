{
    "id": 383,
    "title": "九月九日忆山东兄弟",
    "author": "王维",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "独在异乡为异客，",
            "pinyin": "dú zài yì xiāng wéi yì kè ，"
        },
        {
            "text": "每逢佳节倍思亲。",
            "pinyin": "měi féng jiā jié bèi sī qīn 。"
        },
        {
            "text": "遥知兄弟登高处，",
            "pinyin": "yáo zhī xiōng dì dēng gāo chǔ ，"
        },
        {
            "text": "遍插茱萸少一人。",
            "pinyin": "biàn chā zhū yú shǎo yī rén 。"
        }
    ],
