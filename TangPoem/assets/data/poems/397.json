{
    "id": 397,
    "title": "滁州西涧",
    "author": "韦应物",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "独怜幽草涧边生，",
            "pinyin": "dú lián yōu cǎo jiàn biān shēng ，"
        },
        {
            "text": "上有黄鹂深树鸣。",
            "pinyin": "shàng yǒu huáng lí shēn shù míng 。"
        },
        {
            "text": "春潮带雨晚来急，",
            "pinyin": "chūn cháo dài yǔ wǎn lái jí ，"
        },
        {
            "text": "野渡无人舟自横。",
            "pinyin": "yě dù wú rén zhōu zì héng 。"
        }
    ],
    "annotation": "",
    "translation": "",
