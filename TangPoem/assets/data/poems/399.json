{
    "id": 399,
    "title": "早春呈水部张十八员外",
    "author": "韩愈",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "天街小雨润如酥，",
            "pinyin": "tiān jiē xiǎo yǔ rùn rú sū ，"
        },
        {
            "text": "草色遥看近却无。",
            "pinyin": "cǎo sè yáo kàn jìn què wú 。"
        },
        {
            "text": "最是一年春好处，",
            "pinyin": "zuì shì yī nián chūn hǎo chǔ ，"
        },
        {
            "text": "绝胜烟柳满皇都。",
            "pinyin": "jué shèng yān liǔ mǎn huáng dū 。"
        }
    ],
