{
    "id": 405,
    "title": "忆江南",
    "author": "白居易",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "江南好，",
            "pinyin": "jiāng nán hǎo ，"
        },
        {
            "text": "风景旧曾谙。",
            "pinyin": "fēng jǐng jiù zēng ān 。"
        },
        {
            "text": "日出江花红胜火，",
            "pinyin": "rì chū jiāng huā hóng shèng huǒ ，"
        },
        {
            "text": "春来江水绿如蓝。",
            "pinyin": "chūn lái jiāng shuǐ lǜ rú lán 。"
        },
        {
            "text": "能不忆江南？",
            "pinyin": "néng bù yì jiāng nán ？"
        }
    ],
    "annotation": "",
    "translation": "",
