{
    "id": 415,
    "title": "江上渔者",
    "author": "范仲淹",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "江上往来人，",
            "pinyin": "jiāng shàng wǎng lái rén ，"
        },
        {
            "text": "但爱鲈鱼美。",
            "pinyin": "dàn ài lú yú měi 。"
        },
        {
            "text": "君看一叶舟，",
            "pinyin": "jūn kàn yī yè zhōu ，"
        },
        {
            "text": "出没风波里。",
            "pinyin": "chū méi fēng bō lǐ 。"
        }
    ],
    "annotation": "",
    "translation": "",
