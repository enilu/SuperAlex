{
    "id": 417,
    "title": "泊船瓜洲",
    "author": "王安石",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "京口瓜洲一水间，",
            "pinyin": "jīng kǒu guā zhōu yī shuǐ jiān ，"
        },
        {
            "text": "钟山只隔数重山。",
            "pinyin": "zhōng shān zhī gé shù zhòng shān 。"
        },
        {
            "text": "春风又绿江南岸，",
            "pinyin": "chūn fēng yòu lǜ jiāng nán àn ，"
        },
        {
            "text": "明月何时照我还。",
            "pinyin": "míng yuè hé shí zhào wǒ huán 。"
        }
    ],
    "annotation": "",
    "translation": "",
