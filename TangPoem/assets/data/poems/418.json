{
    "id": 418,
    "title": "书湖阴先生壁",
    "author": "王安石",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "茅檐长扫净无苔，",
            "pinyin": "máo yán cháng sǎo jìng wú tái ，"
        },
        {
            "text": "花木成畦手自栽。",
            "pinyin": "huā mù chéng qí shǒu zì zāi 。"
        },
        {
            "text": "一水护田将绿绕，",
            "pinyin": "yī shuǐ hù tián jiāng lǜ rào ，"
        },
        {
            "text": "两山排闼送青来。",
            "pinyin": "liǎng shān pái tà sòng qīng lái 。"
        }
    ],
    "annotation": "",
    "translation": "",
