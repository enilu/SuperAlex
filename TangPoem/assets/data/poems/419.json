{
    "id": 419,
    "title": "六月二十七日望湖楼醉书",
    "author": "苏轼",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "黑云翻墨未遮山，",
            "pinyin": "hēi yún fān mò wèi zhē shān ，"
        },
        {
            "text": "白雨跳珠乱入船。",
            "pinyin": "bái yǔ tiào zhū luàn rù chuán 。"
        },
        {
            "text": "卷地风来忽吹散，",
            "pinyin": "juàn dì fēng lái hū chuī sàn ，"
        },
        {
            "text": "望湖楼下水如天。",
            "pinyin": "wàng hú lóu xià shuǐ rú tiān 。"
        }
    ],
    "annotation": "",
    "translation": "",
