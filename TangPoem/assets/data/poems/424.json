{
    "id": 424,
    "title": "三衢道中",
    "author": "曾几",
    "dynasty": "南宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "梅子黄时日日晴，",
            "pinyin": "méi zǐ huáng shí rì rì qíng ，"
        },
        {
            "text": "小溪泛尽却山行。",
            "pinyin": "xiǎo xī fàn jìn què shān háng 。"
        },
        {
            "text": "绿阴不减来时路，",
            "pinyin": "lǜ yīn bù jiǎn lái shí lù ，"
        },
        {
            "text": "添得黄鹂四五声。",
            "pinyin": "tiān dé huáng lí sì wǔ shēng 。"
        }
    ],
    "annotation": "",
    "translation": "",
