{
    "id": 426,
    "title": "秋夜将晓出篱门迎凉有感",
    "author": "陆游",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "三万里河东入海，",
            "pinyin": "sān wàn lǐ hé dōng rù hǎi ，"
        },
        {
            "text": "五千仞岳上摩天。",
            "pinyin": "wǔ qiān rèn yuè shàng mó tiān 。"
        },
        {
            "text": "遗民泪尽胡尘里，",
            "pinyin": "yí mín lèi jìn hú chén lǐ ，"
        },
        {
            "text": "难望王师又一年。",
            "pinyin": "nán wàng wáng shī yòu yī nián 。"
        }
    ],
