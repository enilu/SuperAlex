{
    "id": 427,
    "title": "四时田园杂兴",
    "author": "范成大",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "昼出耘田夜绩麻，",
            "pinyin": "zhòu chū yún tián yè jì má ，"
        },
        {
            "text": "村庄儿女各当家。",
            "pinyin": "cūn zhuāng ér nǚ gè dāng jiā 。"
        },
        {
            "text": "童孙未解供耕织，",
            "pinyin": "tóng sūn wèi jiě gōng gēng zhī ，"
        },
        {
            "text": "也傍桑阴学种瓜。",
            "pinyin": "yě bàng sāng yīn xué zhǒng guā 。"
        }
    ],
    "annotation": "",
    "translation": "",
