{
    "id": 428,
    "title": "四时田园杂兴",
    "author": "范成大",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "梅子金黄杏子肥，",
            "pinyin": "méi zǐ jīn huáng xìng zǐ féi ，"
        },
        {
            "text": "麦花雪白菜花稀。",
            "pinyin": "mài huā xuě bái cài huā xī 。"
        },
        {
            "text": "日长篱落无人过，",
            "pinyin": "rì cháng lí luò wú rén guò ，"
        },
        {
            "text": "唯有蜻蜓蛱蝶飞。",
            "pinyin": "wéi yǒu qīng tíng jiá dié fēi 。"
        }
    ],
