{
    "id": 430,
    "title": "晓出净慈寺送林子方",
    "author": "杨万里",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "毕竟西湖六月中，",
            "pinyin": "bì jìng xī hú liù yuè zhōng ，"
        },
        {
            "text": "风光不与四时同。",
            "pinyin": "fēng guāng bù yǔ sì shí tóng 。"
        },
        {
            "text": "接天莲叶无穷碧，",
            "pinyin": "jiē tiān lián yè wú qióng bì ，"
        },
        {
            "text": "映日荷花别样红。",
            "pinyin": "yìng rì hé huā bié yàng hóng 。"
        }
    ],
    "annotation": "",
    "translation": "",
