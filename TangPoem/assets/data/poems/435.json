{
    "id": 435,
    "title": "乡村四月",
    "author": "翁卷",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "绿遍山原白满川，",
            "pinyin": "lǜ biàn shān yuán bái mǎn chuān ，"
        },
        {
            "text": "子规声里雨如烟。",
            "pinyin": "zǐ guī shēng lǐ yǔ rú yān 。"
        },
        {
            "text": "乡村四月闲人少，",
            "pinyin": "xiāng cūn sì yuè xián rén shǎo ，"
        },
        {
            "text": "才了蚕桑又插田。",
            "pinyin": "cái le cán sāng yòu chā tián 。"
        }
    ],
    "annotation": "",
