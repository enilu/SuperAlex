{
    "id": 437,
    "title": "石灰吟",
    "author": "于谦",
    "dynasty": "明",
    "grade": "小学生必背",
    "content": [
        {
            "text": "千锤万凿出深山，",
            "pinyin": "qiān chuí wàn záo chū shēn shān ，"
        },
        {
            "text": "烈火焚烧若等闲，",
            "pinyin": "liè huǒ fén shāo ruò děng xián ，"
        },
        {
            "text": "粉身碎骨浑不怕，",
            "pinyin": "fěn shēn suì gǔ hún bù pà ，"
        },
        {
            "text": "要留清白在人间。",
            "pinyin": "yào liú qīng bái zài rén jiān 。"
        }
    ],
    "annotation": "",
