{
    "id": 452,
    "title": "闻王昌龄左迁龙标遥有此寄",
    "author": "李白",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "杨花落尽子规啼，",
            "pinyin": "yáng huā luò jìn zǐ guī tí ，"
        },
        {
            "text": "闻道龙标过五溪。",
            "pinyin": "wén dào lóng biāo guò wǔ xī 。"
        },
        {
            "text": "我寄愁心与明月，",
            "pinyin": "wǒ jì chóu xīn yǔ míng yuè ，"
        },
        {
            "text": "随风直到夜郎西。",
            "pinyin": "suí fēng zhí dào yè láng xī 。"
        }
    ],
    "annotation": "",
    "translation": "",
