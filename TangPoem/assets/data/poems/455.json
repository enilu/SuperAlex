{
    "id": 455,
    "title": "闻官军收河南河北",
    "author": "杜甫",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "剑外忽传收蓟北，",
            "pinyin": "jiàn wài hū chuán shōu jì běi ，"
        },
        {
            "text": "初闻涕泪满衣裳。",
            "pinyin": "chū wén tì lèi mǎn yī cháng 。"
        },
        {
            "text": "却看妻子愁何在，",
            "pinyin": "què kàn qī zǐ chóu hé zài ，"
        },
        {
            "text": "漫卷诗书喜欲狂。",
            "pinyin": "màn juàn shī shū xǐ yù kuáng 。"
        },
        {
            "text": "白日放歌须纵酒，",
            "pinyin": "bái rì fàng gē xū zòng jiǔ ，"
        },
        {
            "text": "青春作伴好还乡。",
            "pinyin": "qīng chūn zuò bàn hǎo huán xiāng 。"
        },
        {
            "text": "即从巴峡穿巫峡，",
            "pinyin": "jí cóng bā xiá chuān wū xiá ，"
        },
        {
            "text": "便下襄阳向洛阳。",
            "pinyin": "biàn xià xiāng yáng xiàng luò yáng 。"
        }
    ],
    "annotation": "",
