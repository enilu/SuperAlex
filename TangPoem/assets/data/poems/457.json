{
    "id": 457,
    "title": "江南逢李龟年",
    "author": "杜甫",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "岐王宅里寻常见，",
            "pinyin": "qí wáng zhái lǐ xún cháng jiàn ，"
        },
        {
            "text": "崔九堂前几度闻。",
            "pinyin": "cuī jiǔ táng qián jī dù wén 。"
        },
        {
            "text": "正是江南好风景，",
            "pinyin": "zhèng shì jiāng nán hǎo fēng jǐng ，"
        },
        {
            "text": "落花时节又逢君。",
            "pinyin": "luò huā shí jié yòu féng jūn 。"
        }
    ],
