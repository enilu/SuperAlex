{
    "id": 458,
    "title": "江畔独步寻花",
    "author": "杜甫",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "黄四娘家花满蹊，",
            "pinyin": "huáng sì niáng jiā huā mǎn qī ，"
        },
        {
            "text": "千朵万朵压枝低。",
            "pinyin": "qiān duǒ wàn duǒ yā zhī dī 。"
        },
        {
            "text": "留连戏蝶时时舞，",
            "pinyin": "liú lián xì dié shí shí wǔ ，"
        },
        {
            "text": "自在娇莺恰恰啼。",
            "pinyin": "zì zài jiāo yīng qià qià tí 。"
        }
    ],
    "annotation": "",
    "translation": "",
