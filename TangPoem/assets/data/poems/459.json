{
    "id": 459,
    "title": "房兵曹胡马",
    "author": "杜甫",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "胡马大宛名，",
            "pinyin": "hú mǎ dà wǎn míng ，"
        },
        {
            "text": "锋棱瘦骨成。",
            "pinyin": "fēng léng shòu gǔ chéng 。"
        },
        {
            "text": "竹批双耳峻，",
            "pinyin": "zhú pī shuāng ěr jùn ，"
        },
        {
            "text": "风入四蹄轻。",
            "pinyin": "fēng rù sì tí qīng 。"
        },
        {
            "text": "所向无空阔，",
            "pinyin": "suǒ xiàng wú kōng kuò ，"
        },
        {
            "text": "真堪托死生。",
            "pinyin": "zhēn kān tuō sǐ shēng 。"
        },
        {
            "text": "骁腾有如此，",
            "pinyin": "xiāo téng yǒu rú cǐ ，"
        },
        {
            "text": "万里可横行。",
            "pinyin": "wàn lǐ kě héng háng 。"
        }
    ],
    "annotation": "",
    "translation": "",
    "audio": "assets/audio/recite/459.mp3"
}