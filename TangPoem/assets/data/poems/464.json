    "content": [
        {
            "text": "苍苍竹林寺，",
            "pinyin": "cāng cāng zhú lín sì ，"
        },
        {
            "text": "杳杳钟声晚。",
            "pinyin": "yǎo yǎo zhōng shēng wǎn 。"
        },
        {
            "text": "荷笠带斜阳，",
            "pinyin": "hé lì dài xié yáng ，"
        },
        {
            "text": "青山独归远。",
            "pinyin": "qīng shān dú guī yuǎn 。"
        }
