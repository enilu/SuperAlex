    "title": "过华清宫",
    "author": "杜牧",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "长安回望绣成堆，",
            "pinyin": "cháng ān huí wàng xiù chéng duī ，"
        },
        {
            "text": "山顶千门次第开。",
            "pinyin": "shān dǐng qiān mén cì dì kāi 。"
        },
        {
            "text": "一骑红尘妃子笑，",
            "pinyin": "yī qí hóng chén fēi zǐ xiào ，"
        },
        {
            "text": "无人知是荔枝来。",
            "pinyin": "wú rén zhī shì lì zhī lái 。"
        }
    ],
