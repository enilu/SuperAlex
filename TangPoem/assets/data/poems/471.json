{
    "id": 471,
    "title": "寄杨州韩绰判官",
    "author": "杜牧",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "青山隐隐水迢迢，",
            "pinyin": "qīng shān yǐn yǐn shuǐ tiáo tiáo ，"
        },
        {
            "text": "秋尽江南草木凋。",
            "pinyin": "qiū jìn jiāng nán cǎo mù diāo 。"
        },
        {
            "text": "二十四桥明月夜，",
            "pinyin": "èr shí sì qiáo míng yuè yè ，"
        },
        {
            "text": "玉人何处教吹箫。",
            "pinyin": "yù rén hé chǔ jiào chuī xiāo 。"
        }
    ],
