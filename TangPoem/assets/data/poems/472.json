{
    "id": 472,
    "title": "商山早行",
    "author": "温庭筠",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "晨起动征铎，",
            "pinyin": "chén qǐ dòng zhēng duó ，"
        },
        {
            "text": "客行悲故乡。",
            "pinyin": "kè háng bēi gù xiāng 。"
        },
        {
            "text": "鸡声茅店月，",
            "pinyin": "jī shēng máo diàn yuè ，"
        },
        {
            "text": "人迹板桥霜。",
            "pinyin": "rén jì bǎn qiáo shuāng 。"
        },
        {
            "text": "槲叶落山路，",
            "pinyin": "hú yè luò shān lù ，"
        },
        {
            "text": "枳花明驿墙。",
            "pinyin": "zhǐ huā míng yì qiáng 。"
        },
        {
            "text": "因思杜陵梦，",
            "pinyin": "yīn sī dù líng mèng ，"
        },
        {
            "text": "凫雁满回塘。",
            "pinyin": "fú yàn mǎn huí táng 。"
        }
    ],
    "annotation": "",
    "translation": "",
