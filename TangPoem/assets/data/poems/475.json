{
    "id": 475,
    "title": "竹里馆",
    "author": "王维",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "独坐幽篁里，",
            "pinyin": "dú zuò yōu huáng lǐ ，"
        },
        {
            "text": "弹琴复长啸。",
            "pinyin": "dàn qín fù cháng xiào 。"
        },
        {
            "text": "深林人不知，",
            "pinyin": "shēn lín rén bù zhī ，"
        },
        {
            "text": "明月来相照。",
            "pinyin": "míng yuè lái xiāng zhào 。"
        }
    ],
