    "title": "相思",
    "author": "王维",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "红豆生南国，",
            "pinyin": "hóng dòu shēng nán guó ，"
        },
        {
            "text": "春来发几枝。",
            "pinyin": "chūn lái fā jī zhī 。"
        },
        {
            "text": "愿君多采撷，",
            "pinyin": "yuàn jūn duō cǎi xié ，"
        },
        {
            "text": "此物最相思。",
            "pinyin": "cǐ wù zuì xiāng sī 。"
        }
    ],
