{
    "id": 480,
    "title": "乞巧",
    "author": "林杰",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "七夕今宵看碧霄，",
            "pinyin": "qī xī jīn xiāo kàn bì xiāo ，"
        },
        {
            "text": "牵牛织女渡河桥。",
            "pinyin": "qiān niú zhī nǚ dù hé qiáo 。"
        },
        {
            "text": "家家乞巧望秋月，",
            "pinyin": "jiā jiā qǐ qiǎo wàng qiū yuè ，"
        },
        {
            "text": "穿尽红丝几万条。",
            "pinyin": "chuān jìn hóng sī jī wàn tiáo 。"
        }
    ],
