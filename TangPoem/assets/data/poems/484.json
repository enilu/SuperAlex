    "title": "雪",
    "author": "罗隐",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "尽道丰年瑞，",
            "pinyin": "jìn dào fēng nián ruì ，"
        },
        {
            "text": "丰年事若何。",
            "pinyin": "fēng nián shì ruò hé 。"
        },
        {
            "text": "长安有贫者，",
            "pinyin": "cháng ān yǒu pín zhě ，"
        },
        {
            "text": "为瑞不宜多。",
            "pinyin": "wéi ruì bù yí duō 。"
        }
    ],
