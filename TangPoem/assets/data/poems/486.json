{
    "id": 486,
    "title": "蝉",
    "author": "虞世南",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "垂緌饮清露，",
            "pinyin": "chuí ruí yǐn qīng lòu ，"
        },
        {
            "text": "流响出疏桐。",
            "pinyin": "liú xiǎng chū shū tóng 。"
        },
        {
            "text": "居高声自远，",
            "pinyin": "jū gāo shēng zì yuǎn ，"
        },
        {
            "text": "非是藉秋风。",
            "pinyin": "fēi shì jiè qiū fēng 。"
        }
    ],
