{
    "id": 487,
    "title": "逢入京使",
    "author": "岑参",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "故园东望路漫漫，",
            "pinyin": "gù yuán dōng wàng lù màn màn ，"
        },
        {
            "text": "双袖龙钟泪不干。",
            "pinyin": "shuāng xiù lóng zhōng lèi bù gān 。"
        },
        {
            "text": "马上相逢无纸笔，",
            "pinyin": "mǎ shàng xiāng féng wú zhǐ bǐ ，"
        },
        {
            "text": "凭君传语报平安。",
            "pinyin": "píng jūn chuán yǔ bào píng ān 。"
        }
    ],
