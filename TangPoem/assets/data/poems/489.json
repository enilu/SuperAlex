{
    "id": 489,
    "title": "题都城南庄",
    "author": "崔护",
    "dynasty": "唐",
    "grade": "小学生必背",
    "content": [
        {
            "text": "去年今日此门中，",
            "pinyin": "qù nián jīn rì cǐ mén zhōng ，"
        },
        {
            "text": "人面桃花相映红。",
            "pinyin": "rén miàn táo huā xiāng yìng hóng 。"
        },
        {
            "text": "人面不知何处在，",
            "pinyin": "rén miàn bù zhī hé chǔ zài ，"
        },
        {
            "text": "桃花依旧笑春风。",
            "pinyin": "táo huā yī jiù xiào chūn fēng 。"
        }
    ],
