{
    "id": 493,
    "title": "菩萨蛮·书江西造口壁",
    "author": "辛弃疾",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "郁孤台下清江水，",
            "pinyin": "yù gū tái xià qīng jiāng shuǐ ，"
        },
        {
            "text": "中间多少行人泪。",
            "pinyin": "zhōng jiān duō shǎo háng rén lèi 。"
        },
        {
            "text": "西北望长安，",
            "pinyin": "xī běi wàng cháng ān ，"
        },
        {
            "text": "可怜无数山。",
            "pinyin": "kě lián wú shù shān 。"
        },
        {
            "text": "青山遮不住，",
            "pinyin": "qīng shān zhē bù zhù ，"
        },
        {
            "text": "毕竟东流去。",
            "pinyin": "bì jìng dōng liú qù 。"
        },
        {
            "text": "江晚正愁余，",
            "pinyin": "jiāng wǎn zhèng chóu yú ，"
        },
        {
            "text": "山深闻鹧鸪。",
            "pinyin": "shān shēn wén zhè gū 。"
        }
    ],
    "annotation": "",
    "translation": "",
