{
    "id": 495,
    "title": "登飞来峰",
    "author": "王安石",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "飞来山上千寻塔，",
            "pinyin": "fēi lái shān shàng qiān xún tǎ ，"
        },
        {
            "text": "闻说鸡鸣见日升。",
            "pinyin": "wén shuō jī míng jiàn rì shēng 。"
        },
        {
            "text": "不畏浮云遮望眼，",
            "pinyin": "bù wèi fú yún zhē wàng yǎn ，"
        },
        {
            "text": "自缘身在最高层。",
            "pinyin": "zì yuán shēn zài zuì gāo céng 。"
        }
    ],
    "annotation": "",
    "translation": "",
