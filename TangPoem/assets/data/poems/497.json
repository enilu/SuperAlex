{
    "id": 497,
    "title": "江上",
    "author": "王安石",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "江北秋阴一半开，",
            "pinyin": "jiāng běi qiū yīn yī bàn kāi ，"
        },
        {
            "text": "晚云含雨却低回。",
            "pinyin": "wǎn yún hán yǔ què dī huí 。"
        },
        {
            "text": "青山缭绕疑无路，",
            "pinyin": "qīng shān liáo rào yí wú lù ，"
        },
        {
            "text": "忽见千帆隐映来。",
            "pinyin": "hū jiàn qiān fān yǐn yìng lái 。"
        }
    ],
