{
    "id": 498,
    "title": "过松源晨炊漆公店",
    "author": "杨万里",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "莫言下岭便无难，",
            "pinyin": "mò yán xià lǐng biàn wú nán ，"
        },
        {
            "text": "赚得行人空喜欢。",
            "pinyin": "zhuàn dé háng rén kōng xǐ huān 。"
        },
        {
            "text": "正入万山圈子里，",
            "pinyin": "zhèng rù wàn shān quān zǐ lǐ ，"
        },
        {
            "text": "一山放过一山拦。",
            "pinyin": "yī shān fàng guò yī shān lán 。"
        }
    ],
