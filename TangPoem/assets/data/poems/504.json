{
    "id": 504,
    "title": "赠刘景文",
    "author": "苏轼",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "荷尽已无擎雨盖，",
            "pinyin": "hé jìn yǐ wú qíng yǔ gài ，"
        },
        {
            "text": "菊残犹有傲霜枝。",
            "pinyin": "jú cán yóu yǒu ào shuāng zhī 。"
        },
        {
            "text": "一年好景君须记，",
            "pinyin": "yī nián hǎo jǐng jūn xū jì ，"
        },
        {
            "text": "正是橙黄橘绿时。",
            "pinyin": "zhèng shì chéng huáng jú lǜ shí 。"
        }
    ],
