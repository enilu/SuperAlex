{
    "id": 507,
    "title": "春日偶成",
    "author": "程颢",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "云淡风轻过午天，",
            "pinyin": "yún dàn fēng qīng guò wǔ tiān ，"
        },
        {
            "text": "傍花随柳过前川．",
            "pinyin": "bàng huā suí liǔ guò qián chuān ．"
        },
        {
            "text": "时人不识余心乐，",
            "pinyin": "shí rén bù shí yú xīn lè ，"
        },
        {
            "text": "将谓偷闲学少年．",
            "pinyin": "jiāng wèi tōu xián xué shǎo nián ．"
        }
    ],
