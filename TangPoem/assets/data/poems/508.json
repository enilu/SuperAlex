{
    "id": 508,
    "title": "蚕妇",
    "author": "张俞",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "昨日入城市，",
            "pinyin": "zuó rì rù chéng shì ，"
        },
        {
            "text": "归来泪满巾。",
            "pinyin": "guī lái lèi mǎn jīn 。"
        },
        {
            "text": "遍身罗绮者，",
            "pinyin": "biàn shēn luó qǐ zhě ，"
        },
        {
            "text": "不是养蚕人。",
            "pinyin": "bù shì yǎng cán rén 。"
        }
    ],
    "annotation": "",
    "translation": "",
