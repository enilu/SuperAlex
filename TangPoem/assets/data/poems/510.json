{
    "id": 510,
    "title": "咏华山",
    "author": "寇准",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "只有天在上，",
            "pinyin": "zhī yǒu tiān zài shàng ，"
        },
        {
            "text": "更无山与齐。",
            "pinyin": "gēng wú shān yǔ qí 。"
        },
        {
            "text": "举头红日近，",
            "pinyin": "jǔ tóu hóng rì jìn ，"
        },
        {
            "text": "回首白云低。",
            "pinyin": "huí shǒu bái yún dī 。"
        }
    ],
