{
    "id": 511,
    "title": "过零丁洋",
    "author": "文天祥",
    "dynasty": "宋",
    "grade": "小学生必背",
    "content": [
        {
            "text": "辛苦遭逢起一经，",
            "pinyin": "xīn kǔ zāo féng qǐ yī jīng ，"
        },
        {
            "text": "干戈寥落四周星。",
            "pinyin": "gān gē liáo luò sì zhōu xīng 。"
        },
        {
            "text": "山河破碎风飘絮，",
            "pinyin": "shān hé pò suì fēng piāo xù ，"
        },
        {
            "text": "身世浮沉雨打萍。",
            "pinyin": "shēn shì fú chén yǔ dǎ píng 。"
        },
        {
            "text": "惶恐滩头说惶恐，",
            "pinyin": "huáng kǒng tān tóu shuō huáng kǒng ，"
        },
        {
            "text": "零丁洋里叹零丁。",
            "pinyin": "líng dīng yáng lǐ tàn líng dīng 。"
        },
        {
            "text": "人生自古谁无死，",
            "pinyin": "rén shēng zì gǔ shuí wú sǐ ，"
        },
        {
            "text": "留取丹心照汗青。",
            "pinyin": "liú qǔ dān xīn zhào hàn qīng 。"
        }
    ],
    "annotation": "",
