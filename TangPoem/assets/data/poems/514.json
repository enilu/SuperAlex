{
    "id": 514,
    "title": "朝天子·咏喇叭",
    "author": "王磐",
    "dynasty": "明",
    "grade": "小学生必背",
    "content": [
        {
            "text": "喇叭，",
            "pinyin": "lǎ bā ，"
        },
        {
            "text": "锁呐，",
            "pinyin": "suǒ nà"
        },
        {
            "text": "曲儿小腔儿大。",
            "pinyin": "qū ér xiǎo qiāng ér dà 。"
        },
        {
            "text": "官船来往乱如麻，",
            "pinyin": "guān chuán lái wǎng luàn rú má ，"
        },
        {
            "text": "全仗你抬声价。",
            "pinyin": "quán zhàng nǐ tái shēng jià 。"
        },
        {
            "text": "军听了军愁，",
            "pinyin": "jūn tīng le jūn chóu ，"
        },
        {
            "text": "民听了民怕。",
            "pinyin": "mín tīng le mín pà 。"
        },
        {
            "text": "哪里去辨甚么真共假？眼见的吹翻了这家，",
            "pinyin": "nǎ lǐ qù biàn shèn mó zhēn gòng jiǎ ？ yǎn jiàn de chuī fān le zhè jiā ，"
        },
        {
            "text": "吹伤了那家，",
            "pinyin": "chuī shāng le nà jiā ，"
        },
        {
            "text": "只吹的水尽鹅飞罢！",
            "pinyin": "zhī chuī de shuǐ jìn é fēi bà ！"
        }
    ],
    "annotation": "",
    "translation": "",
