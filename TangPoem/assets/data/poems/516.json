{
    "id": 516,
    "title": "题秋江独钓图",
    "author": "王士禛",
    "dynasty": "清",
    "grade": "小学生必背",
    "content": [
        {
            "text": "一蓑一笠一扁舟，",
            "pinyin": "yī suō yī lì yī biǎn zhōu ，"
        },
        {
            "text": "一丈丝纶一寸钩。",
            "pinyin": "yī zhàng sī lún yī cùn gōu 。"
        },
        {
            "text": "一曲高歌一樽酒，",
            "pinyin": "yī qū gāo gē yī zūn jiǔ ，"
        },
        {
            "text": "一人独钓一江秋。",
            "pinyin": "yī rén dú diào yī jiāng qiū 。"
        }
    ],
