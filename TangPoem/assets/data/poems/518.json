{
    "id": 518,
    "title": "舟夜书所见",
    "author": "查慎行",
    "dynasty": "清",
    "grade": "小学生必背",
    "content": [
        {
            "text": "月黑见渔灯，",
            "pinyin": "yuè hēi jiàn yú dēng ，"
        },
        {
            "text": "孤光一点萤。",
            "pinyin": "gū guāng yī diǎn yíng 。"
        },
        {
            "text": "微微风簇浪，",
            "pinyin": "wēi wēi fēng cù làng ，"
        },
        {
            "text": "散作满河星。",
            "pinyin": "sàn zuò mǎn hé xīng 。"
        }
    ],
    "annotation": "",
    "translation": "",
