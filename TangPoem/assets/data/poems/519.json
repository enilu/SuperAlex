{
    "id": 519,
    "title": "墨竹图题诗",
    "author": "郑燮",
    "dynasty": "清",
    "grade": "小学生必背",
    "content": [
        {
            "text": "衙斋卧听萧萧竹，",
            "pinyin": "yá zhāi wò tīng xiāo xiāo zhú ，"
        },
        {
            "text": "疑是民间疾苦声。",
            "pinyin": "yí shì mín jiān jí kǔ shēng 。"
        },
        {
            "text": "些小吾曹州县吏，",
            "pinyin": "xiē xiǎo wú cáo zhōu xiàn lì ，"
        },
        {
            "text": "一枝一叶总关情。",
            "pinyin": "yī zhī yī yè zǒng guān qíng 。"
        }
    ],
    "annotation": "",
    "translation": "",
