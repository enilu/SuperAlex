# 学习工作台生产环境变量模板。
# 真实文件：/var/lib/homework-workbench/secrets.env（chmod 600，不入 Git）。
# HOMEWORK_SECRET_KEY 用 `openssl rand -hex 32` 生成后替换。
HOMEWORK_ENV=production
HOMEWORK_SECRET_KEY=change-me-openssl-rand-hex-32
HOMEWORK_DB=/var/lib/homework-workbench/homework.db
HOMEWORK_UPLOAD_DIR=/var/lib/homework-workbench/uploads
HOMEWORK_PUBLIC_FILES_ROOT=/opt/microapp-store/site/homework/files
HOMEWORK_MAX_UPLOAD=52428800
HOMEWORK_URL_PREFIX=/homework
# HTTPS 生效后改为 1（会话 cookie 仅走 Secure）
HOMEWORK_COOKIE_SECURE=0
HOMEWORK_LOGIN_RATE_LIMIT=5
HOMEWORK_LOGIN_RATE_WINDOW=60
